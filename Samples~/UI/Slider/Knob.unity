  m_Name: 
  m_EditorClassIdentifier: com.csound.unity::Csound.Unity.CsoundUnity
  logCsoundOutput: 0
  initializeOnAwake: 1
  mute: 0
  processClipAudio: 0
  loudVolumeWarning: 1
  loudWarningThreshold: 10
  overrideSamplingRate: 0
  audioRate: 44100
  controlRate: 44100
  ksmps: 32
  updateOutputBuffer: 0
  audioInputRoutes: []
  muteAudioInputRoutes: 0
  _measureDspLoad: 0
  csoundScore: 
  environmentSettings: []
  _csoundFileGUID: 8288029b027de40e2badb15a7e72983b
  _csoundString: '<Cabbage>

    form caption("Rotary Slider aka Knob") size(310,
    100), guiMode("queue"), pluginId("def1")

    rslider bounds(0, 20, 50, 50)
    range(20, 4000, 440, 1, 0.001) valuetextbox(1) channel("freqSlider") value(440)
    velocity(50)

    </Cabbage>

    <CsoundSynthesizer>

    <CsOptions>

    -n
    -d

    </CsOptions>

    <CsInstruments>

    ; Initialize the global variables.

    ksmps
    = 32

    nchnls = 2

    0dbfs = 1

    

    instr 1

    kEnv adsr .3,
    .2, .5, .4

    aOut vco2 kEnv, chnget:k("freqSlider")

    outs aOut, aOut

    endin

    

    </CsInstruments>

    <CsScore>

    ;causes
    Csound to run for about 7000 years...

    f0 z

    i1 0 z

    </CsScore>

    </CsoundSynthesizer>

'
  _csoundFileName: Knob.csd
  _csoundAsset: {fileID: 102900000, guid: 8288029b027de40e2badb15a7e72983b, type: 3}
  _channels:
  - type: form
    channel: 
    text: 
    caption: Rotary Slider aka Knob
    min: 0
    max: 0
    value: 0
    skew: 0
    increment: 0
    options: []
    channelY: 
    minY: 0
    maxY: 0
    value2: 0
    x: 0
    y: 0
    width: 0
    height: 0
  - type: rslider
    channel: freqSlider
    text: 
    caption: 
    min: 20
    max: 4000
    value: 440
    skew: 1
    increment: 0.001
    options: []
    channelY: 
    minY: 0
    maxY: 0
    value2: 0
    x: 0
    y: 20
    width: 50
    height: 50
  _availableAudioChannels: []
  _nchnls: 2
