  m_Name: 
  m_EditorClassIdentifier: com.csound.unity::Csound.Unity.CsoundUnity
  logCsoundOutput: 0
  initializeOnAwake: 1
  mute: 0
  processClipAudio: 0
  loudVolumeWarning: 1
  loudWarningThreshold: 10
  overrideSamplingRate: 0
  audioRate: 44100
  controlRate: 44100
  ksmps: 32
  updateOutputBuffer: 0
  audioInputRoutes: []
  muteAudioInputRoutes: 0
  _measureDspLoad: 0
  csoundScore: 
  environmentSettings: []
  _csoundFileGUID: cf4edc4bfd09c4f439499c677fe1e866
  _csoundString: '<Cabbage>

    form caption("Template") size(310, 100), guiMode("queue"),
    pluginId("def1")

    nslider bounds(12, 10, 57, 22) channel("freqSlider") text("Midi
    Note") range(38, 88, 72, 1, 1) velocity(50)

    label bounds(12, 40, 100, 22)
    channel("freqLabel") text("Midi Note")

    

    

    </Cabbage>

    <CsoundSynthesizer>

    <CsOptions>

    -n
    -d

    </CsOptions>

    <CsInstruments>

    ; Initialize the global variables.

    ksmps
    = 32

    nchnls = 2

    0dbfs = 1

    

    instr 1

    kEnv adsr .3,
    .2, .5, .4

    

    aOut vco2 kEnv, cpsmidinn:k(chnget:k("freqSlider"))

    outs
    aOut, aOut

    endin

    

    </CsInstruments>

    <CsScore>

    ;causes
    Csound to run for about 7000 years...

    f0 z

    i1 0 z

    </CsScore>

    </CsoundSynthesizer>

'
  _csoundFileName: NSlider.csd
  _csoundAsset: {fileID: 102900000, guid: cf4edc4bfd09c4f439499c677fe1e866, type: 3}
