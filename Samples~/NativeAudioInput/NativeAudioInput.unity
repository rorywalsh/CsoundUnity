  m_Script: {fileID: 11500000, guid: 3d20258c641c94f0ea3dc32cfe3de904, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _audioPath: 1
  _generatorStartupDelay: 0
  logCsoundOutput: 1
  initializeOnAwake: 1
  mute: 0
  processClipAudio: 0
  loudVolumeWarning: 1
  loudWarningThreshold: 10
  overrideSamplingRate: 0
  audioRate: 44100
  controlRate: 344
  ksmps: 128
  updateOutputBuffer: 0
  audioInputRoutes: []
  muteAudioInputRoutes: 0
  _measureDspLoad: 0
  csoundScore: 
  environmentSettings: []
  _csoundFileGUID: 3f78b956d4f84f9f82adb4ed513ce712
  _csoundString: "; NativeInputPassthrough.csd\r\n; Minimal CSD for testing CsoundUnity
    native audio input.\r\n;\r\n; Reads from the audio input (fed by NativeAudioInputManager
    via the spin buffer)\r\n; and passes it to the output with a gain control channel.\r\n;\r\n;
    Channels:\r\n;   \"gain\"   - output gain, range 0..2, default 1.0\r\n;\r\n;
    nchnls_i must match the number of channels you open in NativeAudioInputManager.\r\n;
    Change it to 2 for stereo testing.\r\n\r\n<CsoundSynthesizer>\r\n<CsOptions>\r\n-n
    -d\r\n</CsOptions>\r\n<CsInstruments>\r\n\r\nsr      = 48000\r\nksmps   = 128\r\nnchnls 
    = 2\r\nnchnls_i = 2\r\n0dbfs   = 1\r\n\r\ninstr 1\r\n    kGain   chnget \"gain\"\r\n   
    if kGain == 0 then\r\n        kGain = 1\r\n    endif\r\n\r\n    aInL     inch
    1               ; read from spin channel 1\r\n    aInR     inch 2\r\n    ; For
    stereo output, spread the mono input to both channels.\r\n    aOutL    = aInL
    * kGain\r\n    aOutR    = aInR * kGain\r\n    out     aOutL, aOutR\r\nendin\r\n\r\n</CsInstruments>\r\n<CsScore>\r\n;
    f0 z extends the score to an astronomically large time so Csound never\r\n; stops
    on its own. i 1 0 z starts the instrument for the same duration.\r\n; (Csound
    7 terminates on \"e\" even with -1-duration instruments \u2014 use z instead.)\r\nf0
    z\r\ni 1 0 z\r\n</CsScore>\r\n</CsoundSynthesizer>\r\n"
  _csoundFileName: NativeInputPassthrough.csd
  _csoundAsset: {fileID: 102900000, guid: 3f78b956d4f84f9f82adb4ed513ce712, type: 3}
  _channels: []
  _availableAudioChannels: []
  _nchnls: 2
  _audioChannelsToAdd: []
  _audioChannelsToRemove: []
  _drawCsoundString: 0
  _drawTestScore: 0
  _drawSettings: 1
  _drawAudioInputRoutes: 1
  _drawChannels: 1
  _drawAudioChannels: 0
  _drawPresets: 0
