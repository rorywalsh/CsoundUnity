--- !u!114 &419786449
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 419786447}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d20258c641c94f0ea3dc32cfe3de904, type: 3}
  m_Name: 
  m_EditorClassIdentifier: com.csound.unity::Csound.Unity.CsoundUnity
  logCsoundOutput: 0
  initializeOnAwake: 1
  mute: 0
  pauseProcessing: 0
  processClipAudio: 0
  loudVolumeWarning: 1
  loudWarningThreshold: 10
  overrideSamplingRate: 0
  audioRate: 44100
  controlRate: 44100
  ksmps: 32
  updateOutputBuffer: 0
  fadeInSeconds: 0
  audioInputRoutes: []
  muteAudioInputRoutes: 0
  _measureDspLoad: 0
  csoundScore: 
  environmentSettings: []
  _csoundFileGUID: 94b33efafd4f043f58beda36254a48e7
  _csoundString: "<Cabbage>\nform caption(\"String Channels\"), size(300, 34)\n\nhslider
    bounds(0, 0, 300, 33) range(55, 880, 220, .5, 0.001) valuetextbox(1) channel(\"freq\")
    value(220)\n</Cabbage>\n<CsoundSynthesizer>\n<CsOptions>\n</CsOptions>\n<CsInstruments>\n\n;
    Two channels that carry text instead of numbers.\n;\n;   \"shape\"  \u2014 read
    from Unity: which waveform to play, by name\n;   \"status\" \u2014 written back
    for Unity: the name this instrument actually honoured\n;\n; A string channel
    is read with chnget into an S variable and compared with strcmpk, which works
    at\n; k-rate and so follows the value while the scene runs. Numbers would have
    done this job too; what\n; a string buys is that both sides name the same thing
    the same way, with no table of magic numbers\n; to keep in step between the csd
    and the game.\n\nksmps  = 32\nnchnls = 2\n0dbfs  = 1\n\ngiSine ftgen 1, 0, 4096,
    10, 1\ngiSaw  ftgen 2, 0, 4096, 10, 1, 1/2, 1/3, 1/4, 1/5, 1/6, 1/7, 1/8\ngiSqr 
    ftgen 3, 0, 4096, 10, 1, 0, 1/3, 0, 1/5, 0, 1/7, 0, 1/9\n\ninstr 1\n\n  kFreq
    chnget \"freq\"\n  kFreq portk kFreq, 0.02\n\n  Sshape chnget \"shape\"\n\n 
    ; Unknown names fall back to the sine rather than going silent: a sample that
    answers nothing\n  ; when it is given something unexpected is hard to tell from
    one that is broken.\n  kFn = 1\n  if strcmpk(Sshape, \"saw\") == 0 then\n   
    kFn = 2\n  elseif strcmpk(Sshape, \"square\") == 0 then\n    kFn = 3\n  endif\n\n 
    aSig oscilikt 0.2, kFreq, kFn\n  outs aSig, aSig\n\n  ; What Unity reads back.
    The round trip is the point: the game asks by name and is told, by name,\n  ;
    what it got \u2014 which is how it finds out that a name was not understood.\n 
    if kFn == 2 then\n    Sstatus = \"saw\"\n  elseif kFn == 3 then\n    Sstatus
    = \"square\"\n  else\n    Sstatus = \"sine\"\n  endif\n  chnset Sstatus, \"status\"\n\nendin\n\n</CsInstruments>\n<CsScore>\nf0
    z\ni1 0 -1\n</CsScore>\n</CsoundSynthesizer>\n"
  _csoundFileName: StringChannels.csd
  _csoundAsset: {fileID: 102900000, guid: 94b33efafd4f043f58beda36254a48e7, type: 3}
  _channels:
  - type: form
    channel: 
    text: 
    caption: String Channels
    min: 0
    max: 0
    value: 0
    skew: 0
    increment: 0
    options: []
    channelY: 
    minY: 0
    maxY: 0
    value2: 0
    x: 0
    y: 0
    width: 300
    height: 34
  - type: hslider
    channel: freq
    text: 
    caption: 
    min: 55
    max: 880
    value: 220
    skew: 0.5
    increment: 0.001
    options: []
    channelY: 
    minY: 0
    maxY: 0
    value2: 0
    x: 0
    y: 0
    width: 300
    height: 33
  _availableAudioChannels: []
  _unsupportedWidgets: []
  _nchnls: 2
  _audioChannelsToAdd: []
  _audioChannelsToRemove: []
  _drawCsoundString: 0
  _drawTestScore: 0
  _drawSettings: 0
  _drawAudioInputRoutes: 1
  _drawChannels: 0
  _drawAudioChannels: 0
  _drawPresets: 0
  _drawPresetsLoad: 0
  _drawPresetsSave: 0
  _drawPresetsImport: 0
  _showRuntimeEnvironmentPath: 0
