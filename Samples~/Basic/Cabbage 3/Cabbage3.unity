--- !u!114 &569379598
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 569379596}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d20258c641c94f0ea3dc32cfe3de904, type: 3}
  m_Name: 
  m_EditorClassIdentifier: com.csound.unity::Csound.Unity.CsoundUnity
  logCsoundOutput: 0
  initializeOnAwake: 1
  mute: 0
  pauseProcessing: 0
  processClipAudio: 0
  loudVolumeWarning: 1
  loudWarningThreshold: 10
  overrideSamplingRate: 0
  audioRate: 44100
  controlRate: 44100
  ksmps: 32
  updateOutputBuffer: 0
  fadeInSeconds: 0
  audioInputRoutes: []
  muteAudioInputRoutes: 0
  _measureDspLoad: 0
  csoundScore: 
  environmentSettings: []
  _csoundFileGUID: 6703cda73487d4cebb0f3daf6d1d62cb
  _csoundString: "<Cabbage>\n{\n  \"//\": \"Cabbage 3 writes its widgets as
    JSON. JSON has no comments, so this is a property.\",\n  \"pluginId\":
    \"cu30\",\n  \"channelConfig\": [ { \"name\": \"stereo\", \"ins\": 0,
    \"outs\": 2 } ],\n  \"widgets\": [\n    {\n      \"type\": \"form\",\n      \"caption\":
    \"Cabbage 3\",\n      \"size\": { \"width\": 460, \"height\": 320 }\n    },\n    {\n      \"type\":
    \"horizontalSlider\",\n      \"bounds\": { \"left\": 10, \"top\": 10,
    \"width\": 280, \"height\": 30 },\n      \"label\": { \"text\": \"Gain\"
    },\n      \"channels\": [\n        { \"id\": \"gain\", \"range\": { \"min\":
    0, \"max\": 1, \"defaultValue\": 0.25, \"skew\": 1, \"increment\": 0.001 }
    }\n      ],\n      \"style\": { \"track\": { \"fillColor\": \"#93d200\" }
    }\n    },\n    {\n      \"type\": \"rotarySlider\",\n      \"bounds\": {
    \"left\": 300, \"top\": 10, \"width\": 90, \"height\": 90 },\n      \"label\":
    { \"text\": \"Pitch\" },\n      \"channels\": [\n        { \"id\": \"freq\",
    \"range\": { \"min\": 55, \"max\": 880, \"defaultValue\": 110, \"skew\":
    0.5, \"increment\": 1 } }\n      ]\n    },\n    {\n      \"//\": \"Two
    cutoffs, two widgets. Cabbage 3 documents no two-handle slider, and several
    channels on one widget are several channels, not several handles.\",\n      \"type\":
    \"horizontalSlider\",\n      \"bounds\": { \"left\": 10, \"top\": 50,
    \"width\": 280, \"height\": 30 },\n      \"label\": { \"text\": \"Low cut\"
    },\n      \"channels\": [\n        { \"id\": \"lowCut\", \"range\": {
    \"min\": 20, \"max\": 18000, \"defaultValue\": 120, \"skew\": 0.5,
    \"increment\": 1 } }\n      ]\n    },\n    {\n      \"type\":
    \"horizontalSlider\",\n      \"bounds\": { \"left\": 10, \"top\": 90,
    \"width\": 280, \"height\": 30 },\n      \"label\": { \"text\": \"High cut\"
    },\n      \"channels\": [\n        { \"id\": \"highCut\", \"range\": {
    \"min\": 20, \"max\": 18000, \"defaultValue\": 4000, \"skew\": 0.5,
    \"increment\": 1 } }\n      ]\n    },\n    {\n      \"//\": \"The first item
    sends 0, and that is the number the orchestra below reads.\",\n      \"type\":
    \"comboBox\",\n      \"bounds\": { \"left\": 10, \"top\": 130, \"width\":
    140, \"height\": 30 },\n      \"channels\": [\n        { \"id\":
    \"waveform\", \"range\": { \"defaultValue\": 1 } }\n      ],\n      \"items\":
    [ \"Sine\", \"Saw\", \"Square\" ]\n    },\n    {\n      \"type\":
    \"checkBox\",\n      \"bounds\": { \"left\": 160, \"top\": 130, \"width\":
    130, \"height\": 30 },\n      \"label\": { \"text\": \"Filter\" },\n      \"channels\":
    [\n        { \"id\": \"filterOn\", \"range\": { \"defaultValue\": 1 } }\n      ]\n    },\n    {\n      \"//\":
    \"An xyPad whose channels are the two directions of one drag, the one case
    read as a pair.\",\n      \"type\": \"xyPad\",\n      \"bounds\": {
    \"left\": 10, \"top\": 170, \"width\": 140, \"height\": 140 },\n      \"label\":
    { \"text\": \"Motion\" },\n      \"channels\": [\n        { \"id\":
    \"tremoloRate\", \"event\": \"mouseDragX\", \"range\": { \"min\": 0,
    \"max\": 12,   \"defaultValue\": 3,     \"skew\": 1, \"increment\": 0.01 }
    },\n        { \"id\": \"detune\",      \"event\": \"mouseDragY\", \"range\":
    { \"min\": 0, \"max\": 0.03, \"defaultValue\": 0.004, \"skew\": 1,
    \"increment\": 0.0001 } }\n      ]\n    }\n  ]\n}\n</Cabbage>\n\n<CsoundSynthesizer>\n<CsOptions>\n-n
    -d\n</CsOptions>\n<CsInstruments>\nsr      = 48000\nksmps   = 32\nnchnls  =
    2\n0dbfs   = 1\n\ninstr 1\n  kwave    chnget \"waveform\"\n  kfiltOn  chnget
    \"filterOn\"\n\n  ; A control channel steps once per control period, and a
    step in a gain or a filter cutoff is\n  ; heard as zipper noise while a
    slider moves. portk ramps each one; the third argument is the\n  ; value to
    start from, read from the same channel at init, so nothing sweeps up from
    zero when\n  ; the instrument starts. The waveform and the filter switch are
    left alone: they choose a state,\n  ; and halfway between two states is not
    a state.\n  iGain    chnget \"gain\"\n  iFreq    chnget \"freq\"\n  iLowCut  chnget
    \"lowCut\"\n  iHighCut chnget \"highCut\"\n  iRate    chnget
    \"tremoloRate\"\n  iDetune  chnget \"detune\"\n\n  kgain    portk
    chnget:k(\"gain\"),        0.02, iGain\n  kfreq    portk chnget:k(\"freq\"),        0.01,
    iFreq\n  klowCut  portk chnget:k(\"lowCut\"),      0.02, iLowCut\n  khighCut
    portk chnget:k(\"highCut\"),     0.02, iHighCut\n  krate    portk
    chnget:k(\"tremoloRate\"), 0.05, iRate\n  kdetune  portk
    chnget:k(\"detune\"),      0.02, iDetune\n\n  ; A Cabbage 3 combobox sends
    the index of the selected item starting at 0, and that is what\n  ; arrives
    here: 0 is the first entry of items[]. A Cabbage 2 csd would count from 1.\n  kfn
    = (kwave == 1 ? 2 : (kwave == 2 ? 3 : 1))\n\n  aLeft  oscilikt 1, kfreq,
    kfn\n  aRight oscilikt 1, kfreq * (1 + kdetune), kfn\n\n  if kfiltOn > 0
    then\n    aLeft  butterhp aLeft,  klowCut\n    aLeft  butterlp aLeft,  khighCut\n    aRight
    butterhp aRight, klowCut\n    aRight butterlp aRight, khighCut\n  endif\n\n  ktrem
    oscili 0.35, krate, 1\n  kamp  = kgain * (0.65 + ktrem)\n\n  aLeft  = aLeft  *
    kamp\n  aRight = aRight * kamp\n\n  out aLeft,
    aRight\nendin\n\n</CsInstruments>\n<CsScore>\nf0 3600\nf1 0 16384 10 1\nf2 0
    16384 10 1 0.5 0.333 0.25 0.2 0.166 0.142 0.125\nf3 0 16384 10 1 0 0.333 0
    0.2 0 0.142 0 0.111\ni1 0 z\n</CsScore>\n</CsoundSynthesizer>\n"
  _csoundFileName: Cabbage3.csd
  _csoundAsset: {fileID: 102900000, guid: 6703cda73487d4cebb0f3daf6d1d62cb, type: 3}
