  _csoundFileGUID: 19c3e472a61314aff9389a70471ea2db
  _csoundString: "<Cabbage>\nform caption(\"Path Tone\"), size(300, 67)\n\nhslider
    bounds(0,  0, 300, 33) range(55, 880, 220, .5, 0.001) valuetextbox(1) channel(\"freq\")
    value(220)\nhslider bounds(0, 33, 300, 33) range(0,    1, 0.12, 1, 0.001) valuetextbox(1)
    channel(\"amp\")  value(0.12)\n</Cabbage>\n<CsoundSynthesizer>\n<CsOptions>\n</CsOptions>\n<CsInstruments>\n\n;
    One tone, used by every instance in this sample: what changes between them is
    not the\n; csd but the audio path the component is set to. A csd never knows
    which path carries it.\n;\n; sr comes from Unity's audio settings; ksmps below
    is used as written.\n\nksmps  = 32\nnchnls = 2\n0dbfs  = 1\n\ninstr 1\n\n  kFreq
    chnget \"freq\"\n  kAmp  chnget \"amp\"\n  kFreq portk kFreq, 0.02\n  kAmp  portk
    kAmp,  0.05\n\n  ; A slow tremolo, so a stage that is frozen rather than silenced
    is recognisable:\n  ; on return a muted instance has moved on, a paused one carries
    on where it stopped.\n  kTrem oscili 0.25, 1.5\n  aSig  poscil kAmp * (0.75 +
    kTrem), kFreq\n\n  outs aSig, aSig\nendin\n\n</CsInstruments>\n<CsScore>\nf0
    z\ni1 0 -1\n</CsScore>\n</CsoundSynthesizer>\n"
  _csoundFileName: PathTone.csd
  _csoundAsset: {fileID: 102900000, guid: 19c3e472a61314aff9389a70471ea2db, type: 3}
