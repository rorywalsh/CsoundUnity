  m_Script: {fileID: 11500000, guid: ff99c92c233ec4227a259ef5c1851c8c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Csound.Unity.Samples.AudioOutputPath.AudioOutputPathDemo
  _rows:
  - csound: {fileID: 789849294}
    label: OnAudioFilterRead
    note: Every Unity version. Audio goes through the AudioSource and the mixer,
      so AudioSource mute works.
    level: 0
  - csound: {fileID: 1208287278}
    label: IAudioGenerator
    note: Unity 6+. Csound drives the AudioSource with no carrier clip, and the latency
      is constant.
    level: 0
  - csound: {fileID: 865822187}
    label: RootOutput
    note: 'Unity 6+. Writes to Unity''s main output and bypasses the mixer: the AudioSource
      mute above does nothing here.'
    level: 0
  _fontScale: 1
