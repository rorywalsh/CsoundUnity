--- !u!114 &841759012
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 841759010}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d20258c641c94f0ea3dc32cfe3de904, type: 3}
  m_Name: 
  m_EditorClassIdentifier: com.csound.unity::Csound.Unity.CsoundUnity
  logCsoundOutput: 0
  initializeOnAwake: 1
  mute: 0
  pauseProcessing: 0
  processClipAudio: 0
  loudVolumeWarning: 1
  loudWarningThreshold: 10
  overrideSamplingRate: 0
  audioRate: 48000
  controlRate: 1500
  ksmps: 32
  updateOutputBuffer: 1
  fadeInSeconds: 0
  audioInputRoutes: []
  muteAudioInputRoutes: 0
  _measureDspLoad: 1
  csoundScore: 
  environmentSettings: []
  _csoundFileGUID: d3b90243189c24300bbe925709ba6c50
  _csoundString: "<Cabbage>\nform caption(\"StereoOscChannels\"), size(300,
    330)\n\nhslider bounds(0,  0, 300, 33) range(20, 16000, 440, .5, 0.001)
    valuetextbox(1) channel(\"freq\")   value(440)\nhslider bounds(0, 33, 300,
    33) range(0,  30,      0,  1, 0.001) valuetextbox(1) channel(\"detune\")
    value(0)\nhslider bounds(0, 66, 300, 33) range(0,   1,    0.6,  1, 0.001)
    valuetextbox(1) channel(\"amp\")    value(0.6)\nhslider bounds(0,  99, 300,
    33) range(0,   1,    0.0,  1, 0.001) valuetextbox(1) channel(\"output\")   value(0.0)\nhslider
    bounds(0, 132, 300, 33) range(0,   4,    0.0,  1, 0.001) valuetextbox(1)
    channel(\"rampDepth\") value(0.0)\nhslider bounds(0, 165, 300, 33) range(20,
    4000, 660,  .5, 0.001) valuetextbox(1) channel(\"toneFreq\")  value(660)\nhslider
    bounds(0, 198, 300, 33) range(0,   10,  1.5,  1, 0.001) valuetextbox(1)
    channel(\"toneRate\")   value(1.5)\nhslider bounds(0, 231, 300, 33) range(0,    1,  0.7,  1,
    0.001) valuetextbox(1) channel(\"toneAmp\")    value(0.7)\nhslider bounds(0,
    264, 300, 33) range(0,    1, 0.75,  1, 0.001) valuetextbox(1)
    channel(\"toneDuty\")   value(0.75)\nhslider bounds(0, 297, 300, 33)
    range(0,    2, 0.25,  1, 0.001) valuetextbox(1) channel(\"toneRelease\")
    value(0.25)\n</Cabbage>\n<CsoundSynthesizer>\n<CsOptions>\n-n
    -d\n</CsOptions>\n<CsInstruments>\n\n; Stereo oscillator that writes its
    output to two named audio channels\n; instead of the AudioSource output
    buffer.\n;\n; CsoundUnity setup:\n;   - \"audioL\" and \"audioR\" are listed
    as Named Audio Channels in the inspector.\n;     They appear in
    namedAudioChannelDataDict and can be routed to another\n;     CsoundUnity
    instance via Audio Input Routes.\n;   - \"outs\" is gated by the \"output\"
    channel, which defaults to 0: this instance\n;     feeds the chain through
    its named channels while its own AudioSource stays\n;     silent. Raise
    \"output\" to monitor it directly as well.\n;\n; Exposed channels (set from
    CsoundUnity inspector or scripts):\n;   \"freq\"    - oscillator centre
    frequency in Hz  (default 440)\n;   \"detune\"  - stereo detune spread in Hz         (default
    0)\n;   \"amp\"     - amplitude 0..1                     (default 0.6)\n;   \"output\"  -
    own AudioSource output gate 0..1, does not affect\n;               \"audioL\"/\"audioR\"                  (default
    0)\n\nsr     = 48000\nksmps  = 32\nnchnls = 2\n0dbfs  = 1\n\ninstr 1\n\n  ;
    ---- parameters -------------------------------------------------------\n  kFreq   chnget
    \"freq\"\n  kDetune chnget \"detune\"\n  kAmp    chnget \"amp\"\n  kOutput
    chnget \"output\"\n  \n  ; Guard only kFreq against zero/negative (poscil
    undefined there).\n  ; kDetune = 0 is valid (no stereo spread).\n  ; kAmp    =
    0 is valid (silence).\n  kFreq = (kFreq < 1 ? 440 : kFreq)\n\n  ; Smooth
    parameter changes\n  kFreq   portk kFreq,   0.02\n  kDetune portk kDetune,
    0.02\n  kAmp    portk kAmp,    0.02\n\n  ; ---- Csound-side ramp, for
    telling \"muted\" from \"paused\" apart ------------\n  ; A slow rising ramp
    that restarts every 8 seconds, multiplying the frequency\n  ; by 1..(1 +
    rampDepth). Driven by phasor, so it advances on Csound's own\n  ; k-cycles
    rather than from the host: it therefore keeps running while this\n  ;
    instance is muted (Csound still performs) and freezes while it is paused\n  ;
    (PerformKsmps is skipped). Coming back from a mute the ramp has moved on;\n  ;
    coming back from a pause it resumes at exactly the point it stopped, which\n  ;
    is the audible difference between the two.\n  ; Silent by default (rampDepth
    = 0) so it never interferes with other tests.\n  kRampDepth chnget
    \"rampDepth\"\n  kRamp      phasor 0.125\n  kFreq = kFreq * (1 + kRamp *
    kRampDepth)\n\n  ; ---- startup fade-in
    ---------------------------------------------------\n  ; Ramps amplitude
    from 0 to 1 over 0.3 s so the named channels\n  ; always carry smoothly
    rising audio regardless of Unity init timing.\n  aFadeIn linseg 0, 0.3,
    1\n\n  ; ---- stereo oscillator with detuned L / R for width
    -------------------\n  aLeft  poscil kAmp * aFadeIn, kFreq - kDetune * 0.5\n  aRight
    poscil kAmp * aFadeIn, kFreq + kDetune * 0.5\n\n  ; ---- separate voice on
    its own channel, for CsoundUnityChild -----------\n  ; audioL/audioR are the
    modulator: at 25 Hz they are barely audible on their\n  ; own, and anything
    reading them sounds exactly like whatever they are\n  ; modulating \u2014 so
    a child fed from them is impossible to pick out of the mix.\n  ; This is an
    independent voice with its own pitch and its own pulse rate, so\n  ; it sits
    clearly apart from the FM stage both in register and in rhythm.\n  ;
    toneRate = 0 holds the note instead of repeating it.\n  kToneFreq chnget
    \"toneFreq\"\n  kToneRate chnget \"toneRate\"\n  kToneAmp  chnget
    \"toneAmp\"\n  kToneFreq = (kToneFreq < 1 ? 660 : kToneFreq)\n\n  ; Same
    flat-topped gate as the FM stage: a held note with very short fades, so
    the\n  ; timbre can be judged during it and the gap after it is
    unmistakable.\n  ;   toneRate = notes per second, 0 holds the note (0.5 =
    one every two seconds)\n  ;   toneDuty = fraction of that period the note
    sounds (0.75 of 2 s = a 1.5 s note)\n  kToneDuty chnget \"toneDuty\"\n  kTRate   =
    (kToneRate > 0 ? kToneRate : 1)\n  kTonePh  phasor kTRate\n  ; Fast attack,
    long eased release \u2014 see the note in FMInputModulator.csd: a linear\n  ;
    ramp has a corner in its slope at zero, and the ear hears that corner as
    an\n  ; abrupt stop. smoothstep has zero slope at both ends.\n  kToneRelease
    chnget \"toneRelease\"\n  kTAtk    = max(0.0001, 0.01 * kTRate)\n  kTRel    =
    max(0.0001, min(kToneRelease * kTRate, kToneDuty * 0.9))\n  kTUp     =
    min(1, kTonePh / kTAtk)\n  kTDn     = min(1, max(0, (kToneDuty - kTonePh) /
    kTRel))\n  kTDn     = kTDn * kTDn * (3 - 2 * kTDn)\n  kTGate   = (kTonePh >=
    kToneDuty ? 0 : min(kTUp, kTDn))\n  kToneEnv = (kToneRate <= 0 ? 1 :
    kTGate)\n  aTone poscil kToneAmp * kToneEnv * aFadeIn, kToneFreq\n  chnset
    aTone, \"tone\"\n\n  ; ---- write to named audio channels
    ------------------------------------\n  chnset aLeft,  \"audioL\"\n  chnset
    aRight, \"audioR\"\n\n  ; Gated by \"output\" (default 0): the named
    channels above always carry the\n  ; signal, this only decides whether it is
    also monitored on the AudioSource.\n  outs aLeft*kOutput,
    aRight*kOutput\nendin\n\n</CsInstruments>\n<CsScore>\n; Run indefinitely\nf0
    z\ni1 0 -1\n</CsScore>\n</CsoundSynthesizer>\n"
  _csoundFileName: StereoOscillators.csd
  _csoundAsset: {fileID: 102900000, guid: d3b90243189c24300bbe925709ba6c50, type: 3}
