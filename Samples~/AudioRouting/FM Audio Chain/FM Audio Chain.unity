  csoundScore: 
  environmentSettings: []
  _csoundFileGUID: df9d223925658450a95a1806ecd38f68
  _csoundString: "<Cabbage>\nform caption(\"Chain Reverb\"), size(300,
    165)\n\nhslider bounds(0,   0, 300, 33) range(0, 0.99, 0.9, 1, 0.001)
    valuetextbox(1) channel(\"fblvl\")  value(0.9)\nhslider bounds(0,  33, 300,
    33) range(0,    1,  0.6, 1, 0.001) valuetextbox(1) channel(\"fco\")    value(0.6)\nhslider
    bounds(0,  66, 300, 33) range(0,   20,    1, 1, 0.001) valuetextbox(1)
    channel(\"pitchm\") value(1)\nhslider bounds(0,  99, 300, 33) range(0,    1,    1,
    1, 0.001) valuetextbox(1) channel(\"mix\")    value(1)\nhslider bounds(0,
    132, 300, 33) range(0,    1,    1, 1, 0.001) valuetextbox(1)
    channel(\"amp\")    value(1)\n</Cabbage>\n<CsoundSynthesizer>\n<CsOptions>\n</CsOptions>\n<CsInstruments>\n\n;
    Last stage of the FM Audio Chain: reverberates whatever the FM stage routes
    into it.\n;\n; The channel names are the ones the scene's script expects
    \u2014 fblvl, fco, pitchm, mix, amp \u2014 so\n; it is a drop-in for any
    reverb in this chain.\n;\n; sr comes from Unity's audio settings; ksmps
    below is used as written.\n\nksmps    = 32\nnchnls   = 2\nnchnls_i =
    2\n0dbfs    = 1\n\ninstr 1\n\n  kfblvl  chnget \"fblvl\"    ; tail length:
    reverbsc's feedback, 0.9 is already long\n  kfco    chnget \"fco\"      ;
    damping: 0 is dark, 1 is bright\n  kmix    chnget \"mix\"\n  kamp    chnget
    \"amp\"\n\n  kfblvl portk min(kfblvl, 0.99), 0.05\n  kmix   portk kmix,  0.05\n  kamp   portk
    kamp,  0.02\n\n  ; fco maps 0..1 onto 20 Hz .. 20 kHz on an exponential
    curve, so the knob spends its travel\n  ; where the ear is. The filter sits
    inside the feedback loop, which makes this a decay control\n  ; as much as a
    tone one: at 0.5 the tail is gone in a moment, at 0.9 it rings on.\n  kcurve  =
    (exp(4 * kfco) - 1) / (exp(4) - 1)\n  kcutoff = 20 + kcurve * 19980\n\n  aInL
    inch 1\n  aInR inch 2\n\n  ; Keeps denormals out of the feedback loop, which
    is where they cost CPU.\n  denorm aInL, aInR\n\n  ; pitchm is read once, at
    init: reverbsc takes its pitch modulation at i-rate.\n  ipitchm chnget
    \"pitchm\"\n  aWetL, aWetR reverbsc aInL, aInR, kfblvl, kcutoff, sr,
    ipitchm\n\n  aMixL ntrpol aInL, aWetL, kmix\n  aMixR ntrpol aInR, aWetR,
    kmix\n\n  outs aMixL * kamp, aMixR *
    kamp\nendin\n\n</CsInstruments>\n<CsScore>\nf0 z\ni1 0
    -1\n</CsScore>\n</CsoundSynthesizer>\n"
  _csoundFileName: ChainReverb.csd
  _csoundAsset: {fileID: 102900000, guid: df9d223925658450a95a1806ecd38f68, type: 3}
