  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d20258c641c94f0ea3dc32cfe3de904, type: 3}
  m_Name: 
  m_EditorClassIdentifier: com.csound.unity::Csound.Unity.CsoundUnity
  logCsoundOutput: 0
  initializeOnAwake: 1
  mute: 0
  pauseProcessing: 0
  processClipAudio: 0
  loudVolumeWarning: 1
  loudWarningThreshold: 10
  overrideSamplingRate: 0
  audioRate: 48000
  controlRate: 1500
  ksmps: 32
  updateOutputBuffer: 1
  fadeInSeconds: 0
  audioInputRoutes:
  - source: {fileID: 841759012}
    sourceChannelName: audioL
    destSpinChannel: 0
    level: 1
  - source: {fileID: 841759012}
    sourceChannelName: audioR
    destSpinChannel: 1
    level: 1
  muteAudioInputRoutes: 0
  _measureDspLoad: 1
  csoundScore: 
  environmentSettings: []
  _csoundFileGUID: e306da57773fb411aaceecc2bfe71db4
  _csoundString: "<Cabbage>\r\nform caption(\"FM Input Modulator\"), size(300,
    223)\r\n\r\nhslider bounds(0,   0, 300, 32) range(20, 16000, 440, .5, 0.001)
    valuetextbox(1) channel(\"carrierFreq\") value(440) velocity(50)\r\nhslider
    bounds(0,  32, 300, 32) range(0,  500,   100,  1, 0.001) valuetextbox(1)
    channel(\"deviation\")  value(100) velocity(50)\r\nhslider bounds(0,  64,
    300, 32) range(0,    1,   0.6,  1, 0.001) valuetextbox(1) channel(\"amp\")        value(0.6)
    velocity(50)\r\nhslider bounds(0,  96, 300, 32) range(0,    1,   1.0,  1,
    0.001) valuetextbox(1) channel(\"output\")     value(1.0)
    velocity(50)\r\nhslider bounds(0, 128, 300, 32) range(0,   10,   0.0,  1,
    0.001) valuetextbox(1) channel(\"pulseRate\")  value(0.0)
    velocity(50)\r\nhslider bounds(0, 160, 300, 32) range(0,    1,  0.75,  1,
    0.001) valuetextbox(1) channel(\"pulseDuty\")  value(0.75)
    velocity(50)\r\nhslider bounds(0, 192, 300, 32) range(0,    2,  0.25,  1,
    0.001) valuetextbox(1) channel(\"pulseRelease\") value(0.25)
    velocity(50)\r\n</Cabbage>\r\n<CsoundSynthesizer>\r\n<CsOptions>\r\n-n
    -d\r\n</CsOptions>\r\n<CsInstruments>\r\n\r\n; FM synthesis driven by stereo
    audio routed from another CsoundUnity instance.\r\n;\r\n; CsoundUnity
    setup:\r\n;   - Set Audio Input Routes: source = StereoOscChannels,\r\n;     \"audioL\"
    -> destSpinChannel 0,  \"audioR\" -> destSpinChannel 1.\r\n;   - nchnls_i =
    2 for stereo input.\r\n;   - \"Process Clip Audio\" is NOT needed for audio
    input routes: routes are written\r\n;     straight into spin. That setting
    only concerns the AudioSource clip audio.\r\n;\r\n; This instance is a
    mid-chain node, so it writes its result both to named audio\r\n; channels
    (\"fmL\" / \"fmR\", for routing onwards) and to its own \"outs\" (for\r\n;
    monitoring). The two are independent: set \"output\" to 0 to send this
    instance's\r\n; audio down the chain while keeping its own AudioSource
    silent. Same pattern as\r\n; StereoOscillators. Routing from \"fmL\"/\"fmR\"
    is preferable to the auto-generated\r\n; spout channels
    (\"main_out_0\"/\"main_out_1\"), which are taken after \"outs\" and so\r\n;
    cannot be attenuated independently of the send.\r\n;\r\n; The modulating
    signal (its frequency and timbre) comes entirely from the\r\n; source
    instance.  \"deviation\" here controls the maximum carrier frequency\r\n;
    swing in Hz when the input signal is at full amplitude (0dbfs =
    1):\r\n;\r\n;   instantaneous deviation = aInL * deviation\r\n;\r\n; So
    \"deviation 100\" means the carrier can swing \u00b1100 Hz around
    carrierFreq\r\n; when the source oscillator is at peak amplitude.\r\n;\r\n;
    Exposed channels:\r\n;   \"carrierFreq\"  - carrier base frequency in Hz  (default
    440)\r\n;   \"deviation\"    - max frequency deviation in Hz  (default
    100)\r\n;   \"amp\"          - output amplitude 0..1          (default
    0.6)\r\n;   \"output\"       - own AudioSource output gate 0..1, does not
    affect\r\n;                    \"fmL\"/\"fmR\"                    (default
    1)\r\n;   \"pulseRate\"    - notes per second, 0 = held tone (default
    0)\r\n;   \"pulseDuty\"    - fraction of the period the note sounds (default
    0.75)\r\n\r\nsr       = 48000\r\nksmps    = 32\r\nnchnls   = 2\r\nnchnls_i =
    2\r\n0dbfs    = 1\r\n\r\ninstr 1\r\n\r\n  ; ---- parameters
    -------------------------------------------------------\r\n  kCarrierFreq
    chnget \"carrierFreq\"\r\n  kDeviation   chnget \"deviation\"\r\n  kAmp         chnget
    \"amp\"\r\n  kOutput      chnget \"output\"\r\n\r\n  ; Guard only frequency
    against zero/negative (poscil undefined there).\r\n  ; deviation = 0 is
    valid (pure carrier, no FM).\r\n  ; amp       = 0 is valid (silence).\r\n  kCarrierFreq
    = (kCarrierFreq < 1 ? 440 : kCarrierFreq)\r\n\r\n  ; Smooth parameter
    changes\r\n  kCarrierFreq portk kCarrierFreq, 0.02\r\n  kDeviation   portk
    kDeviation,   0.02\r\n  kAmp         portk kAmp,         0.02\r\n\r\n  ;
    ---- startup fade-in for the FM deviation ------------------------------\r\n  ;
    Ramps modulation depth from 0 to 1 over 1.5 s so that even if the\r\n  ;
    source instance becomes ready slightly after this one, the carrier\r\n  ;
    frequency never jumps abruptly when audio starts arriving in the spin
    buffer.\r\n  aDevFade linseg 0, 1.5, 1\r\n\r\n  ; ---- read stereo input
    from spin buffer (audio input routes) ----------\r\n  aInL inch 1\r\n  aInR
    inch 2\r\n\r\n  ; ---- FM: input signal drives the frequency deviation of
    the carrier ---\r\n  aDevL = aInL * kDeviation * aDevFade\r\n  aDevR = aInR
    * kDeviation * aDevFade\r\n\r\n  aOutL poscil kAmp, kCarrierFreq + aDevL\r\n  aOutR
    poscil kAmp, kCarrierFreq + aDevR\r\n\r\n  ; ---- optional pulsing: repeated
    notes instead of one held tone ---------\r\n  ; A held tone makes the
    interesting questions ambiguous: silence sounds like\r\n  ; silence, a
    looped block sounds like the same tone, and two instances playing\r\n  ; the
    same drone are impossible to tell apart. Repeating notes turn the rhythm\r\n  ;
    into an audible clock \u2014 you can hear whether a pattern stayed in phase
    across\r\n  ; a silence, and a repeated block reads as a stutter rather than
    a nuance.\r\n  ;\r\n  ; The shape is a flat-topped note, not a percussive
    pluck: holding the note is\r\n  ; what lets you judge its timbre, and the
    gap after it is what makes \"did it\r\n  ; stop?\" unambiguous. Fades are a
    few milliseconds \u2014 long enough not to click\r\n  ; (clicks are exactly
    what these tests hunt for), short enough to stay crisp.\r\n  ;\r\n  ;   pulseRate
    = notes per second, 0 keeps the original held tone\r\n  ;               (0.5
    = one note every two seconds)\r\n  ;   pulseDuty = fraction of that period
    the note sounds\r\n  ;               (0.75 of a 2 s period = a 1.5 s note,
    then 0.5 s of silence)\r\n  kPulseRate chnget \"pulseRate\"\r\n  kPulseDuty
    chnget \"pulseDuty\"\r\n  kPRate   = (kPulseRate > 0 ? kPulseRate : 1)\r\n  kPulsePh
    phasor kPRate\r\n  ; 10 ms of fade as a fraction of the period, never more
    than a third of the note\r\n  kPulseRelease chnget \"pulseRelease\"\r\n  ;
    Envelope: fast attack, long eased release. A linear ramp has a corner in
    its\r\n  ; slope right where it reaches zero, and the ear reads that corner
    as an abrupt\r\n  ; stop however short it is \u2014 so the release is shaped
    with a smoothstep, whose\r\n  ; slope is zero at both ends, and given far
    more time than the attack.\r\n  kPAtk  = max(0.05, 0.01 * kPRate)\r\n  kPRel  =
    max(0.05, min(kPulseRelease * kPRate, kPulseDuty * 0.9))\r\n  kPUp   =
    min(1, kPulsePh / kPAtk)\r\n  kPDn   = min(1, max(0, (kPulseDuty - kPulsePh)
    / kPRel))\r\n  kPDn   = kPDn * kPDn * (3 - 2 * kPDn)\r\n  kPGate    =
    (kPulsePh >= kPulseDuty ? 0 : min(kPUp, kPDn))\r\n  kPulseEnv = (kPulseRate
    <= 0 ? 1 : kPGate)\r\n\r\n  aOutL = aOutL * kPulseEnv\r\n  aOutR = aOutR *
    kPulseEnv\r\n\r\n  ; ---- write to named audio channels for routing onwards
    ----------------\r\n  ; Independent of \"outs\" below, so a destination can
    be fed at full level\r\n  ; while this instance's own output is gated down
    by \"output\".\r\n  chnset aOutL, \"fmL\"\r\n  chnset aOutR, \"fmR\"\r\n\r\n  outs
    aOutL * kOutput, aOutR *
    kOutput\r\n\r\nendin\r\n\r\n</CsInstruments>\r\n<CsScore>\r\n; Run
    indefinitely\r\nf0 z\r\ni1 0 -1\r\n</CsScore>\r\n</CsoundSynthesizer>\r\n"
  _csoundFileName: FMInputModulator.csd
  _csoundAsset: {fileID: 102900000, guid: e306da57773fb411aaceecc2bfe71db4, type: 3}
