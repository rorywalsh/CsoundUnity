  - source: {fileID: 2046514975}
    sourceChannelName: fm_R
    destSpinChannel: 1
    level: 1
  muteAudioInputRoutes: 0
  _measureDspLoad: 0
  csoundScore: 
  environmentSettings: []
  _csoundFileGUID: 1f21b98a45d2042ec8f36fb9cf8f4751
  _csoundString: "<Cabbage>\nform caption(\"Reverb\"), size(300, 100)\n\nhslider
    bounds(0,  0, 300, 33) range(0, 0.99, 0.8,  1, 0.001) valuetextbox(1) channel(\"size\")
    value(0.8)\nhslider bounds(0, 33, 300, 33) range(0,    1,  0.7, 1, 0.001) valuetextbox(1)
    channel(\"mix\")  value(0.7)\nhslider bounds(0, 66, 300, 33) range(0,    1, 
    0.7, 1, 0.001) valuetextbox(1) channel(\"amp\")  value(0.7)\n</Cabbage>\n<CsoundSynthesizer>\n<CsOptions>\n</CsOptions>\n<CsInstruments>\n\n;
    Stage 3 of 3 \u2014 the end of the chain, and the only stage you need to hear.\n;\n;
    Reads the audio routed in from stage 2 and reverberates it. Mute the first two\n;
    stages from the panel and this one still receives their signal: an AudioSource\n;
    mute silences the monitor, not the route.\n\nksmps    = 32\nnchnls   = 2\nnchnls_i
    = 2\n0dbfs    = 1\n\ninstr 1\n\n  kSize chnget \"size\"\n  kMix  chnget \"mix\"\n 
    kAmp  chnget \"amp\"\n\n  kSize portk kSize, 0.05\n  kMix  portk kMix,  0.05\n 
    kAmp  portk kAmp,  0.02\n\n  aInL inch 1\n  aInR inch 2\n\n  ; reverbsc wants
    a feedback level below 1 and a cutoff in Hz.\n  aWetL, aWetR reverbsc aInL, aInR,
    kSize, 12000\n\n  aMixL ntrpol aInL, aWetL, kMix\n  aMixR ntrpol aInR, aWetR,
    kMix\n\n  outs aMixL * kAmp, aMixR * kAmp\nendin\n\n</CsInstruments>\n<CsScore>\nf0
    z\ni1 0 -1\n</CsScore>\n</CsoundSynthesizer>\n"
  _csoundFileName: Reverb.csd
