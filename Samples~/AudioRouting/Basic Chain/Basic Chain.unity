  _measureDspLoad: 0
  csoundScore: 
  environmentSettings: []
  _csoundFileGUID: 32ea1c730f7294fbfaf11ee01c5d863a
  _csoundString: "<Cabbage>\nform caption(\"Oscillators\"), size(300, 133)\n\nhslider
    bounds(0,  0, 300, 33) range(20, 2000, 220, .5, 0.001) valuetextbox(1) channel(\"freq\")  
    value(220)\nhslider bounds(0, 33, 300, 33) range(0,    20,   3,  1, 0.001) valuetextbox(1)
    channel(\"detune\") value(3)\nhslider bounds(0, 66, 300, 33) range(0,     1,
    0.25, 1, 0.001) valuetextbox(1) channel(\"amp\")    value(0.25)\nhslider bounds(0,
    99, 300, 33) range(0,     4, 0.35, 1, 0.001) valuetextbox(1) channel(\"rate\")  
    value(0.35)\n</Cabbage>\n<CsoundSynthesizer>\n<CsOptions>\n</CsOptions>\n<CsInstruments>\n\n;
    Stage 1 of 3 \u2014 the source of the chain.\n;\n; Writes its audio to two named
    audio channels, osc_L and osc_R, and also plays it\n; on its own AudioSource.
    The two are independent: an Audio Input Route on the next\n; stage reads the
    named channels, and muting this AudioSource does not touch them.\n;\n; sr comes
    from Unity's audio settings; ksmps below is used as written.\n\nksmps  = 32\nnchnls
    = 2\n0dbfs  = 1\n\ninstr 1\n\n  kFreq   chnget \"freq\"\n  kDetune chnget \"detune\"\n 
    kAmp    chnget \"amp\"\n\n  kFreq   portk kFreq,   0.02\n  kDetune portk kDetune,
    0.02\n  kAmp    portk kAmp,    0.02\n\n  ; Two oscillators a few Hz apart: the
    beating makes the stereo width obvious, and gives the FM\n  ; stage downstream
    something that moves. This one is deliberately continuous: it is the modulator,\n 
    ; and the FM note needs it present for its whole length. The repeated notes are
    made downstream,\n  ; where they belong.\n  aLeft  poscil kAmp, kFreq - kDetune
    * 0.5\n  aRight poscil kAmp, kFreq + kDetune * 0.5\n\n  ; Notes, not a drone,
    and the same notes go to the route and to the output. Half the rate of the\n 
    ; FM stage, so the modulator reaches it every other note: one FM note comes out
    with a timbre,\n  ; the next as a bare sine. That alternation is what a route
    delivering audio sounds like, and\n  ; muting this stage turns every note downstream
    into the bare sine.\n  ; rate = notes per second, 0 holds the note.\n  kRate
    chnget \"rate\"\n  kR    = (kRate > 0 ? kRate : 1)\n  kPh   phasor kR\n  ; 0.45
    of a 2.9 s period: a 1.3 s note and a 1.6 s gap. Shorter gaps read as a pulse,
    longer\n  ; ones stop reading as a cycle at all.\n  kDuty = 0.45\n  kAtk  = 0.025
    * kR\n  kRel  = min(0.25 * kR, kDuty * 0.9)\n  kUp   = min(1, kPh / kAtk)\n 
    kUp   = kUp * kUp * (3 - 2 * kUp)\n  kDn   = min(1, max(0, (kDuty - kPh) / kRel))\n 
    kDn   = kDn * kDn * (3 - 2 * kDn)\n  kGate = (kPh >= kDuty ? 0 : min(kUp, kDn))\n 
    kEnv  = (kRate <= 0 ? 1 : kGate)\n  ; To audio rate before it multiplies audio:
    k-rate steps are heard as a buzz on the fades.\n  aEnv  interp kEnv\n\n  aOutL
    = aLeft  * aEnv\n  aOutR = aRight * aEnv\n\n  ; What the route carries, gated
    like the output. The two stages are separate Csound instances and\n  ; nothing
    aligns their clocks, so a note downstream can begin modulated and end bare; the
    fades\n  ; are long enough that this reads as the timbre moving rather than as
    a click.\n  chnset aOutL, \"osc_L\"\n  chnset aOutR, \"osc_R\"\n\n  outs aOutL,
    aOutR\nendin\n\n</CsInstruments>\n<CsScore>\nf0 z\ni1 0 -1\n</CsScore>\n</CsoundSynthesizer>\n"
  _csoundFileName: Oscillators.csd
  _csoundAsset: {fileID: 102900000, guid: 32ea1c730f7294fbfaf11ee01c5d863a, type: 3}
