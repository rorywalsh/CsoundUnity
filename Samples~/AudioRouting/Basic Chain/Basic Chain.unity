  muteAudioInputRoutes: 0
  _measureDspLoad: 0
  csoundScore: 
  environmentSettings: []
  _csoundFileGUID: 46301fb6fad8547278b5e93abbd605c2
  _csoundString: "<Cabbage>\nform caption(\"FM Voice\"), size(300, 133)\n\nhslider
    bounds(0,  0, 300, 33) range(20, 2000, 330, .5, 0.001) valuetextbox(1) channel(\"carrier\")  
    value(330)\nhslider bounds(0, 33, 300, 33) range(0,  1200, 600,  1, 0.001) valuetextbox(1)
    channel(\"deviation\") value(600)\nhslider bounds(0, 66, 300, 33) range(0,    
    1, 0.25, 1, 0.001) valuetextbox(1) channel(\"amp\")       value(0.25)\nhslider
    bounds(0, 99, 300, 33) range(0,     4, 0.7,  1, 0.001) valuetextbox(1) channel(\"rate\")     
    value(0.7)\n</Cabbage>\n<CsoundSynthesizer>\n<CsOptions>\n</CsOptions>\n<CsInstruments>\n\n;
    Stage 2 of 3 \u2014 reads the audio routed in from stage 1 and uses it as a modulator.\n;\n;
    The route writes into Csound's spin buffer, which is what inch reads. Nothing
    else\n; is needed: Process Clip Audio concerns the AudioSource's clip, not routes.\n;
    nchnls_i = 2 because two channels arrive.\n;\n; Its own result goes to fm_L and
    fm_R for the next stage, and to outs for monitoring. It plays\n; repeated notes
    rather than a drone, so the reverb at the end of the chain has gaps to ring into.\n\nksmps   
    = 32\nnchnls   = 2\nnchnls_i = 2\n0dbfs    = 1\n\ninstr 1\n\n  kCarrier   chnget
    \"carrier\"\n  kDeviation chnget \"deviation\"\n  kAmp       chnget \"amp\"\n\n 
    kCarrier   portk kCarrier,   0.02\n  kDeviation portk kDeviation, 0.02\n  kAmp      
    portk kAmp,       0.02\n\n  ; The two channels routed in from the Oscillators
    instance.\n  aInL inch 1\n  aInR inch 2\n\n  ; Frequency modulation: the incoming
    audio swings the carrier. At deviation 300 a\n  ; full-scale input moves the
    carrier by \xB1300 Hz, so the beating of stage 1 is heard\n  ; here as a moving
    timbre rather than as a pitch. The swing scales with the incoming\n  ; amplitude,
    so it follows the level of stage 1.\n  aOutL poscil kAmp, kCarrier + aInL * kDeviation\n 
    aOutR poscil kAmp, kCarrier + aInR * kDeviation\n\n  ; A pulse train rather than
    a held tone. The gap after each note is the point: that is where\n  ; the reverb
    downstream is heard decaying on its own, which a continuous sound hides completely.\n 
    ; rate = notes per second, 0 holds the note.\n  kRate chnget \"rate\"\n  kR   
    = (kRate > 0 ? kRate : 1)\n  kPh   phasor kR\n  kDuty = 0.5\n  ; Written as a
    fraction of the period times the rate, which comes out as a fixed time: 25 ms
    of\n  ; attack and 250 ms of release whatever the rate is. The release is capped
    so it always fits\n  ; inside the note.\n  kAtk  = 0.025 * kR\n  kRel  = min(0.25
    * kR, kDuty * 0.9)\n  ; Smoothstep at both ends. A linear ramp has a corner in
    its slope where it meets zero, and the\n  ; ear hears that corner as a tick however
    short the ramp is; this one leaves at zero slope and\n  ; arrives at zero slope.\n 
    kUp   = min(1, kPh / kAtk)\n  kUp   = kUp * kUp * (3 - 2 * kUp)\n  kDn   = min(1,
    max(0, (kDuty - kPh) / kRel))\n  kDn   = kDn * kDn * (3 - 2 * kDn)\n  kGate =
    (kPh >= kDuty ? 0 : min(kUp, kDn))\n  kEnv  = (kRate <= 0 ? 1 : kGate)\n\n  ;
    Interpolated up to audio rate before it multiplies audio: a k-rate envelope moves
    in steps of\n  ; one control period, and those steps are heard as a faint buzz
    along the attack and the release.\n  aEnv  interp kEnv\n\n  aOutL = aOutL * aEnv\n 
    aOutR = aOutR * aEnv\n\n  chnset aOutL, \"fm_L\"\n  chnset aOutR, \"fm_R\"\n\n 
    outs aOutL, aOutR\nendin\n\n</CsInstruments>\n<CsScore>\nf0 z\ni1 0 -1\n</CsScore>\n</CsoundSynthesizer>\n"
  _csoundFileName: FMVoice.csd
