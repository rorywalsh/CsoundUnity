  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d20258c641c94f0ea3dc32cfe3de904, type: 3}
  m_Name: 
  m_EditorClassIdentifier: com.csound.unity::Csound.Unity.CsoundUnity
  logCsoundOutput: 0
  initializeOnAwake: 1
  mute: 0
  pauseProcessing: 0
  processClipAudio: 0
  loudVolumeWarning: 1
  loudWarningThreshold: 10
  overrideSamplingRate: 0
  audioRate: 44100
  controlRate: 44100
  ksmps: 32
  updateOutputBuffer: 0
  fadeInSeconds: 0
  audioInputRoutes: []
  muteAudioInputRoutes: 0
  _measureDspLoad: 0
  csoundScore: 
  environmentSettings: []
  _csoundFileGUID: 38ea1169780fb4d85bfc869579a99879
  _csoundString: "<CsoundSynthesizer>\n<CsOptions>\n; Csound only asks the host for
    MIDI when a MIDI device is requested, so without -M the messages\n; sent with
    SendMidiNoteOn and the rest are queued and never collected. rtmidi=null because
    the\n; device is CsoundUnity, not a driver.\n-+rtmidi=null -M0\n</CsOptions>\n<CsInstruments>\n\n;
    The orchestra the API smoke test talks to. Nothing here is meant to be listened
    to for its own\n; sake: every instrument exists so that a public method has something
    to prove.\n;\n;   instr 10   MIDI-triggered: reports the note and velocity it
    received on channels\n;   instr 20   passthrough, for the spin and spout methods\n;  
    instr 30   always on: reports that Csound is running, and the value of a MIDI
    controller\n\nksmps    = 32\nnchnls   = 2\nnchnls_i = 2\n0dbfs    = 1\n\nmassign
    0, 10\n\ninstr 10\n  iNote notnum\n  iVel  veloc\n  chnset iNote, \"midiNote\"\n 
    chnset iVel,  \"midiVel\"\n\n  kEnv madsr 0.01, 0.1, 0.7, 0.2\n  aOut poscil
    0.2 * kEnv * (iVel / 127), cpsmidinn(iNote)\n  outs aOut, aOut\nendin\n\ninstr
    20\n  aIn inch 1\n  outs aIn, aIn\nendin\n\ninstr 30\n  chnset 0.75, \"alive\"\n\n 
    ; ctrl7 reads a controller in any instrument, unlike midic7, which needs a MIDI-activated
    one.\n  kCC ctrl7 1, 1, 0, 127\n  chnset kCC, \"cc1\"\nendin\n\n</CsInstruments>\n<CsScore>\nf0
    z\ni 20 0 -1\ni 30 0 -1\n</CsScore>\n</CsoundSynthesizer>\n"
  _csoundFileName: ApiSmokeTest.csd
  _csoundAsset: {fileID: 102900000, guid: 38ea1169780fb4d85bfc869579a99879, type: 3}
  _channels: []
  _availableAudioChannels: []
  _unsupportedWidgets: []
  _nchnls: 2
  _audioChannelsToAdd: []
  _audioChannelsToRemove: []
