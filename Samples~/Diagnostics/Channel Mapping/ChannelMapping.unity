  _csoundString: "<CsoundSynthesizer>\n<CsOptions>\n</CsOptions>\n<CsInstruments>\n\n;
    Two channels that cannot be mistaken for one another: different pitch, so the
    WAV says which\n; Csound channel reached a speaker, and different amplitude,
    so the recorder's own peak and RMS\n; figures say it too.\n;\n;   channel 1  
    220 Hz   0.50\n;   channel 2   660 Hz   0.25\n\nksmps  = 32\nnchnls = 2\n0dbfs 
    = 1\n\ninstr 1\n  a0 poscil 0.50, 220\n  a1 poscil 0.25, 660\n  outs a0, a1\nendin\n\n</CsInstruments>\n<CsScore>\nf0
    z\ni1 0 -1\n</CsScore>\n</CsoundSynthesizer>\n"
  _csoundFileName: MappingTone2.csd
