  _csoundFileGUID: 8ecb9cc9e8d9147bbb8c9e2bf5f5ec60
  _csoundString: "<CsoundSynthesizer>\n<CsOptions>\n</CsOptions>\n<CsInstruments>\n\n;
    Not a number: the square root of a negative signal. Nothing compares true against
    NaN, so the\n; same comparison that catches a runaway catches this, whatever
    the threshold is set to. It matters\n; most on RootOutput, where what an instance
    writes goes into Unity's own main output.\n\nksmps  = 32\nnchnls = 2\n0dbfs 
    = 1\n\ninstr 1\n  aNeg  poscil 1, 220\n  aNeg  =      -1 - abs(aNeg)\n  a0   
    sqrt   aNeg\n  outs a0, a0\nendin\n\n</CsInstruments>\n<CsScore>\nf0 z\ni1 0
    -1\n</CsScore>\n</CsoundSynthesizer>\n"
  _csoundFileName: NanTone.csd
