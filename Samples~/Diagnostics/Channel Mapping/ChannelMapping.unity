  _csoundString: "<CsoundSynthesizer>\n<CsOptions>\n</CsOptions>\n<CsInstruments>\n\n;
    Six channels, each on its own pitch and its own level, so one recording says
    where each one\n; landed and which ones never left Csound at all.\n;\n;   channel
    1   220 Hz   0.50      channel 4   392 Hz   0.35\n;   channel 2   277 Hz   0.45     
    channel 5   440 Hz   0.30\n;   channel 3   330 Hz   0.40      channel 6   523
    Hz   0.25\n\nksmps  = 32\nnchnls = 6\n0dbfs  = 1\n\ninstr 1\n  a0 poscil 0.50,
    220\n  a1 poscil 0.45, 277\n  a2 poscil 0.40, 330\n  a3 poscil 0.35, 392\n  a4
    poscil 0.30, 440\n  a5 poscil 0.25, 523\n  chnset a0, \"audiochanneltest\"\n 
    outch 1, a0, 2, a1, 3, a2, 4, a3, 5, a4, 6, a5\nendin\n\n</CsInstruments>\n<CsScore>\nf0
    z\ni1 0 -1\n</CsScore>\n</CsoundSynthesizer>\n"
  _csoundFileName: MappingTone6.csd
  _csoundAsset: {fileID: 102900000, guid: 34539677f93394fc9819de619bbfa753, type: 3}
