  csoundScore: 
  environmentSettings: []
  _csoundFileGUID: 45ad202e167d479491bfd3a8ac7e42db
  _csoundFileName: EngineConstantsTest.csd
  _csoundAsset: {fileID: 102900000, guid: 45ad202e167d479491bfd3a8ac7e42db, type: 3}
