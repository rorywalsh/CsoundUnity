  csoundScore: 
  environmentSettings: []
  _csoundFileGUID: d046a25975ceb4e6faf81779194d8177
  _csoundString: "<CsoundSynthesizer>\n<CsOptions>\n</CsOptions>\n<CsInstruments>\n\n;
    A tone that holds still, so anything heard while the listener moves came from
    the movement.\n;\n; Steady and pure on purpose: a click, a zipper or a jump in
    pitch stands out against it, and in a\n; recording it stands out as a step between
    two samples far larger than a sine of this frequency\n; can make. The same signal
    goes out of this instance and into a named channel, so the children\n; reading
    that channel and this instance can be compared under the same movement.\n\nksmps 
    = 32\nnchnls = 2\n0dbfs  = 1\n\ninstr 1\n  aTone poscil 0.3, 330\n  chnset aTone,
    \"tone\"\n  outs aTone, aTone\nendin\n\n</CsInstruments>\n<CsScore>\nf0 z\ni
    1 0 -1\n</CsScore>\n</CsoundSynthesizer>\n"
  _csoundFileName: DopplerTone.csd
  _csoundAsset: {fileID: 102900000, guid: d046a25975ceb4e6faf81779194d8177, type: 3}
  _channels: []
  _availableAudioChannels:
  - tone
  _unsupportedWidgets: []
  _nchnls: 2
  _audioChannelsToAdd: []
  _audioChannelsToRemove: []
  _drawCsoundString: 0
  _drawTestScore: 0
  _drawSettings: 0
  _drawAudioInputRoutes: 1
