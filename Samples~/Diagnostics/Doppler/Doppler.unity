  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d20258c641c94f0ea3dc32cfe3de904, type: 3}
  m_Name: 
  m_EditorClassIdentifier: com.csound.unity::Csound.Unity.CsoundUnity
  logCsoundOutput: 0
  initializeOnAwake: 1
  mute: 0
  pauseProcessing: 0
  processClipAudio: 0
  loudVolumeWarning: 1
  loudWarningThreshold: 10
  overrideSamplingRate: 0
  audioRate: 44100
  controlRate: 44100
  ksmps: 32
  updateOutputBuffer: 0
  fadeInSeconds: 0
  audioInputRoutes: []
  muteAudioInputRoutes: 0
  _measureDspLoad: 0
  csoundScore: 
  environmentSettings: []
  _csoundFileGUID: d7d028636bf5a4e51908c52c3a11183e
  _csoundString: "<CsoundSynthesizer>\n<Cabbage>\nform caption(\"Doppler for children\"),
    size(300, 110)\n\n; The same three numbers as the single voice version, applied
    to both delay lines at once.\nhslider bounds(0, 0, 300, 33) range(0.002, 0.12,
    0.02, 1, 0.001) valuetextbox(1) channel(\"smoothing\") value(0.02) text(\"Smoothing,
    seconds per pole\")\nhslider bounds(0, 36, 300, 33) range(0, 2, 2, 1, 1) valuetextbox(1)
    channel(\"poles\") value(2) text(\"Poles, 0 is none\")\ncombobox bounds(0, 72,
    300, 33) channel(\"interp\") items(\"8 points\", \"16 points\", \"32 points\",
    \"64 points\") value(3) text(\"Tap reads\")\n</Cabbage>\n<CsOptions>\n</CsOptions>\n<CsInstruments>\n\n;
    The Doppler for CsoundUnityChild: one delay line per child, here, in the parent's
    orchestra.\n;\n; A child reads an audio channel this instance publishes and puts
    it somewhere in the scene. The\n; signal is one and the same for all of them,
    so a delay applied once would be right for one child\n; and wrong for the others:
    each is at its own distance and wants its own shift. So each gets a line\n; of
    its own, fed by its own CsoundUnityDoppler, and reads the channel named after
    it.\n;\n; This instance makes no sound of its own: the children are its output.\n\nksmps 
    = 32\nnchnls = 2\n0dbfs  = 1\n\n; One voice: a delay line whose tap follows a
    travel time. Written once and used per child, which is\n; the whole point of
    doing it here rather than in each child.\nopcode DopplerVoice, a, akkkk\n  aSig,
    kDelay, kHalf, kPoles, kInterp xin\n\n  kH      limit  kHalf, 0.001, 1\n  kS1    
    portk  kDelay, kH\n  kS2     portk  kS1, kH\n  kSmooth =      (kPoles < 0.5)
    ? kDelay : ((kPoles < 1.5) ? kS1 : kS2)\n\n  kDel    limit  kSmooth, 0.001, 0.99\n 
    aDel    interp kDel\n\n  aOut    init   0\n\n  aDum    delayr  1\n  ; The channel
    carries the combobox's position, 1 to 4, not the number of points: that is how
    a\n  ; Cabbage combobox arrives here. Fixed sizes because deltapx takes its window
    at init time.\n  if kInterp < 1.5 then\n    aOut  deltapx aDel, 8\n  elseif kInterp
    < 2.5 then\n    aOut  deltapx aDel, 16\n  elseif kInterp < 3.5 then\n    aOut 
    deltapx aDel, 32\n  else\n    aOut  deltapx aDel, 64\n  endif\n          delayw 
    aSig\n\n          xout    aOut\nendop\n\ninstr 1\n  aSig    poscil 0.3, 330\n\n 
    kHalf   chnget \"smoothing\"\n  kPoles  chnget \"poles\"\n  kInterp chnget \"interp\"\n\n 
    ; One CsoundUnityDoppler sits on each child and writes its own travel time here.
    The names come\n  ; from the children themselves: a child reading \"voice1\"
    writes \"voice1delay\", so nothing has to be\n  ; invented or kept in step by
    hand.\n  kDelay1 chnget \"voice1delay\"\n  kDelay2 chnget \"voice2delay\"\n\n 
    aVoice1 DopplerVoice aSig, kDelay1, kHalf, kPoles, kInterp\n  aVoice2 DopplerVoice
    aSig, kDelay2, kHalf, kPoles, kInterp\n\n  ; Each child reads the channel named
    after it.\n  chnset  aVoice1, \"voice1\"\n  chnset  aVoice2, \"voice2\"\n\n 
    ; Nothing is written to the output on purpose: this instance is heard through
    its children. Csound\n  ; clears the output buffer every control cycle, so leaving
    it alone is silence. Writing 'outs 0, 0'\n  ; is not: outs wants a-rate arguments,
    a bare 0 is not one, and the whole orchestra fails to\n  ; compile over it, which
    looks exactly like a parent that is not running.\nendin\n\n</CsInstruments>\n<CsScore>\nf0
    z\ni 1 0 -1\n</CsScore>\n</CsoundSynthesizer>\n"
  _csoundFileName: DopplerChildren.csd
  _csoundAsset: {fileID: 102900000, guid: d7d028636bf5a4e51908c52c3a11183e, type: 3}
