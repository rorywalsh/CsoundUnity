--- !u!114 &378124869
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 378124866}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d20258c641c94f0ea3dc32cfe3de904, type: 3}
  m_Name: 
  m_EditorClassIdentifier: com.csound.unity::Csound.Unity.CsoundUnity
  logCsoundOutput: 0
  initializeOnAwake: 1
  mute: 0
  pauseProcessing: 0
  processClipAudio: 0
  loudVolumeWarning: 1
  loudWarningThreshold: 10
  overrideSamplingRate: 0
  audioRate: 44100
  controlRate: 44100
  ksmps: 32
  updateOutputBuffer: 0
  fadeInSeconds: 0
  audioInputRoutes: []
  muteAudioInputRoutes: 0
  _measureDspLoad: 0
  csoundScore: 
  environmentSettings: []
  _csoundFileGUID: cd66408716b4949008f73dc2c13ac93a
  _csoundString: "<CsoundSynthesizer>\n<Cabbage>\nform caption(\"Doppler by hand\"),
    size(300, 110)\n\n; The three numbers worth trying by ear. They show up in the
    inspector's Control Channels, so a\n; setting can be changed while the scene
    plays without touching this file.\nhslider bounds(0, 0, 300, 33) range(0.002,
    0.12, 0.02, 1, 0.001) valuetextbox(1) channel(\"smoothing\") value(0.02) text(\"Smoothing,
    seconds per pole\")\nhslider bounds(0, 36, 300, 33) range(0, 2, 2, 1, 1) valuetextbox(1)
    channel(\"poles\") value(2) text(\"Poles, 0 is none\")\ncombobox bounds(0, 72,
    300, 33) channel(\"interp\") items(\"8 points\", \"16 points\", \"32 points\",
    \"64 points\") value(3) text(\"Tap reads\")\n</Cabbage>\n<CsOptions>\n</CsOptions>\n<CsInstruments>\n\n;
    The Doppler made in the orchestra.\n;\n; CsoundUnityDoppler writes how long the
    sound takes to reach the listener into the \"delay\" channel,\n; and the tap
    of this delay line follows it. A tap that moves is a Doppler shift, it is right
    however the two sides\n; move, and the sound also arrives late by its own travel
    time, which Unity's Doppler does not do.\n;\n; The component sends the delay
    already in seconds, so the speed of sound lives in one place, its\n; Speed Of
    Sound field, instead of being written again here. One second of line reaches
    340 units at\n; that speed; past that the tap would wrap, so the limit holds
    it inside.\n\nksmps  = 32\nnchnls = 2\n0dbfs  = 1\n\ninstr 1\n  aSig  poscil
    0.3, 330\n\n  ; The three numbers the sliders above drive, so a setting can be
    judged by ear from the inspector\n  ; without touching this file. The defaults
    are what measured best; what each one costs is in\n  ; Documentation~/doppler.md.\n 
    kDelay  chnget \"delay\"            ; seconds of travel time, from CsoundUnityDoppler\n 
    kHalf   chnget \"smoothing\"        ; half-time of each pole, in seconds\n  kPoles 
    chnget \"poles\"            ; 0, 1 or 2\n  kInterp chnget \"interp\"          
    ; the combobox above: 1 is 8 points, 4 is 64\n\n  ; Both poles always run, and
    the one to use is picked after: a filter that is switched off and on\n  ; again
    comes back holding whatever it had, and that jump would be heard.\n  kH     
    limit  kHalf, 0.001, 1\n  kS1     portk  kDelay, kH\n  kS2     portk  kS1, kH\n 
    kSmooth =      (kPoles < 0.5) ? kDelay : ((kPoles < 1.5) ? kS1 : kS2)\n\n  kDel   
    limit  kSmooth, 0.001, 0.99\n  aDel    interp kDel\n\n  aOut    init   0\n\n 
    aDum    delayr  1\n  ; A ladder of fixed sizes, because deltapx takes its window
    at init time and cannot be slid while\n  ; it plays, and restarting the instrument
    for each new size would empty the delay line, which is\n  ; heard. The channel
    carries the combobox's position, 1 to 4, not the number of points: that is\n 
    ; how a Cabbage combobox arrives here.\n  if kInterp < 1.5 then\n    aOut  deltapx
    aDel, 8\n  elseif kInterp < 2.5 then\n    aOut  deltapx aDel, 16\n  elseif kInterp
    < 3.5 then\n    aOut  deltapx aDel, 32\n  else\n    aOut  deltapx aDel, 64\n 
    endif\n          delayw  aSig\n\n  outs aOut, aOut\nendin\n\n</CsInstruments>\n<CsScore>\nf0
    z\ni 1 0 -1\n</CsScore>\n</CsoundSynthesizer>\n"
  _csoundFileName: Doppler.csd
  _csoundAsset: {fileID: 102900000, guid: cd66408716b4949008f73dc2c13ac93a, type: 3}
