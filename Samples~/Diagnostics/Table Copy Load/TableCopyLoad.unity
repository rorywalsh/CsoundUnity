  m_Script: {fileID: 11500000, guid: 3d20258c641c94f0ea3dc32cfe3de904, type: 3}
  m_Name: 
  m_EditorClassIdentifier: com.csound.unity::Csound.Unity.CsoundUnity
  logCsoundOutput: 0
  initializeOnAwake: 1
  mute: 0
  pauseProcessing: 0
  processClipAudio: 0
  loudVolumeWarning: 1
  loudWarningThreshold: 10
  overrideSamplingRate: 0
  audioRate: 44100
  controlRate: 44100
  ksmps: 32
  updateOutputBuffer: 0
  fadeInSeconds: 0
  audioInputRoutes: []
  muteAudioInputRoutes: 0
  _measureDspLoad: 0
  csoundScore: 
  environmentSettings: []
  _csoundFileGUID: ff20aacfe9b048c79572fda426fd916c
  _csoundString: "<CsoundSynthesizer>\n<CsOptions>\n-d\n</CsOptions>\n<CsInstruments>\nksmps = 32\nnchnls = 2\n0dbfs = 1\n\n; Fixed tables avoid compilation or table replacement during a measured phase.\ngiSmall  ftgen 100, 0, 4096, 10, 1\ngiMedium ftgen 101, 0, 65536, 10, 1\ngiLarge  ftgen 102, 0, 1048576, 10, 1\n\nchnset 100, \"table\"\nchnset 1, \"voices\"\n\ninstr 1\n    iVoice = p4\n    kVoices chnget \"voices\"\n    kTable chnget \"table\"\n    ; Smooth voice-count changes before the measured phases.\n    ; Equal-power scaling keeps RMS level comparable as voices are added.\n    ; At 64 voices the sum of all peak amplitudes is at most 0.64.\n    kTarget = (iVoice <= kVoices ? 0.08 / sqrt(max(kVoices, 1)) : 0)\n    kAmplitude portk kTarget, 0.01\n    aAmplitude interp kAmplitude\n    if kAmplitude > 0.0000001 then\n        ; One phase accumulator follows the voice across all table choices. Separate\n        ; oscillators in these branches would restart at unrelated phases when switching.\n        aPhase phasor 110 + iVoice * 3\n        if kTable == 100 then\n            aWave tablei aPhase, 100, 1\n        elseif kTable == 101 then\n            aWave tablei aPhase, 101, 1\n        else\n            aWave tablei aPhase, 102, 1\n        endif\n        aTone = aWave * aAmplitude\n        out aTone, aTone\n    endif\nendin\n\niVoice = 1\nwhile iVoice <= 64 do\n    ; Fractional instrument IDs keep indefinite notes distinct.\n    schedule 1 + iVoice / 1000.0, 0, -1, iVoice\n    iVoice += 1\nod\n</CsInstruments>\n<CsScore>\nf0 z\n</CsScore>\n</CsoundSynthesizer>\n"
  _csoundFileName: TableCopyLoad.csd
  _csoundAsset: {fileID: 102900000, guid: ff20aacfe9b048c79572fda426fd916c, type: 3}
  _channels: []
  _availableAudioChannels: []
  _unsupportedWidgets: []
