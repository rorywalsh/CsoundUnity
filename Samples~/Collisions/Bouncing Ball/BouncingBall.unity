  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d20258c641c94f0ea3dc32cfe3de904, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  logCsoundOutput: 0
  initializeOnAwake: 1
  mute: 0
  pauseProcessing: 0
  processClipAudio: 0
  loudVolumeWarning: 1
  loudWarningThreshold: 10
  overrideSamplingRate: 0
  audioRate: 44100
  controlRate: 1378
  ksmps: 32
  updateOutputBuffer: 0
