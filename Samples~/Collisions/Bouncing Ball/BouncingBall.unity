    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 3
    m_MaxSize: 30
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 0.9
  m_Text: "Andy Farnell\u2019s bouncing ball model, implemented in Csound by Marijana
    Janevska, James Anderson and Joachim Heintz at Incontri, Institute for contemporary
    music at the HMTM Hannover.\n\nThe original CSD schedules the bounces itself,
    with a metro that speeds up as the ball settles. Here the ball is a real rigid
    body instead: click to drop it, move the mouse left or right to give it a horizontal
    push, and every collision sends a single bounce to Csound, with the impulse of
    the impact as its amplitude."
